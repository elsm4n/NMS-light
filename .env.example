# NMS runtime configuration. Provide real secrets through a secret manager or protected environment.
NMS_DATABASE_URL=postgresql://nms_user:change-me@127.0.0.1:5432/rust_nms
NMS_LISTEN_ADDR=127.0.0.1:8080
NMS_JWT_SECRET=
NMS_CREDENTIAL_KEY_HEX=

# Comma-separated CIDR allowlist for network discovery; blank disables scanning.
NMS_DISCOVERY_CIDRS=
NMS_MAX_PROBE_CONCURRENCY=32

# Required only on the first startup while the users table is empty; remove afterwards.
NMS_BOOTSTRAP_ADMIN_EMAIL=
NMS_BOOTSTRAP_ADMIN_PASSWORD=

# Compile-time SQLx query checking reads DATABASE_URL (or SQLX_OFFLINE metadata).
DATABASE_URL=postgresql://nms_user:change-me@127.0.0.1:5432/rust_nms
